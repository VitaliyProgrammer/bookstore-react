# Адреса бекенду для фронтенду. Скопіюй у .env і зміни за потреби.
# /api — через proxy Vite (vite.config.js), CORS у Spring для розробки не потрібен.
# На продакшені тут буде повна адреса, наприклад https://bookstore-api.example.com,
# і тоді в Spring обов'язково має бути налаштований CORS.
VITE_API_BASE_URL=/api
